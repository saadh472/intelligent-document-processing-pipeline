# Optional backend settings. Compose consumes the sign-in/origin/cookie settings below.
# Copy to .env for Compose, or set variables in your shell for manual startup.
# With IDP_PASSWORD unset, startup generates a password in the persistent data volume.
IDP_USERNAME=admin
# IDP_PASSWORD=<a unique password containing at least 12 characters>
IDP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local HTTP only. Set true when serving the application through HTTPS.
SESSION_COOKIE_SECURE=false
# New H2 installations generate database-password.txt in the data directory.
# A directly started backend using an external database requires this shell variable.
# IDP_DATABASE_PASSWORD=<your existing database password>
